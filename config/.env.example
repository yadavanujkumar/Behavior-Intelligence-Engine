# =============================================================================
# Behavior Intelligence Engine - Shared Configuration
# =============================================================================

# ---- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://bie_user:bie_pass@db:5432/behavior_intelligence
DATABASE_POOL_SIZE=10

# ---- Detection Service -------------------------------------------------------
DETECTION_MODEL=yolov8n.pt          # YOLOv8 model variant (n/s/m/l/x)
DETECTION_CONFIDENCE=0.5            # Minimum confidence for detections
DETECTION_DEVICE=cpu                # 'cpu' or 'cuda'

# ---- Tracking Service --------------------------------------------------------
DEEPSORT_MAX_AGE=30                 # Frames to keep a lost track alive
DEEPSORT_N_INIT=3                   # Frames before track is confirmed
DEEPSORT_MAX_COSINE_DIST=0.4        # Cosine distance threshold for ReID

# ---- Behavior Analysis -------------------------------------------------------
LOITERING_TIME_THRESHOLD=120        # Seconds before loitering alert
LOITERING_RADIUS=80                 # Pixels radius for loitering zone
SPEED_THRESHOLD=50                  # Pixels/frame for sudden motion
TRAJECTORY_HISTORY=100              # Max positions to store per ID
REPEATED_PATH_MIN_LOOPS=3           # Min loops to flag repeated traversal
REPEATED_PATH_SIMILARITY=0.85       # Path similarity coefficient

# ---- Alert Service -----------------------------------------------------------
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-3.5-turbo
ALERT_COOLDOWN=30                   # Seconds between alerts for same ID+behavior

# ---- Video / Stream ----------------------------------------------------------
VIDEO_SOURCE=0                      # 0=webcam, or path/URL to video/RTSP
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FRAME_FPS=30
MJPEG_QUALITY=80                    # JPEG quality for /video_feed stream (1-100)

# ---- API Gateway -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256

# ---- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=/app/logs/bie.log
